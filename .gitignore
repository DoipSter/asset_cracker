# Python
__pycache__/
*.py[cod]

# Runtime state: each run's simulated balances and trade history. These are personal
# results, not source, and the app recreates them from scratch on first launch.
kalshi_balance*.json
kalshi_trades*.csv

# Scraped market data: ~8 MB, regenerate with research/scrape_week.py
research/week_data.json
research/week_partial.json

# Parity harness: raw live recordings are large and machine-specific. A recording chosen as
# a test fixture is copied to tools/parity/fixtures/ (force-added past the kalshi_* rules).
tools/parity/recordings/
