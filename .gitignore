# Python
__pycache__/
*.py[cod]

# Runtime state: each run's simulated balances, trade history and debugging logs. These
# are personal results, not source, and the app recreates them from scratch on first launch.
kalshi_balance*.json
kalshi_trades*.csv
kalshi_exits*.csv
kalshi_rounds*.csv
kalshi_bankruptcies*.log
kalshi_bankrupt_*.md
kalshi_sessions*.csv

# measure3's figures on an incomplete TRAIN: printed, freeze nothing, and change every run.
# runs.jsonl, frozen-params.json and the result files ARE committed (the protocol says so).
research/v3/train-progress.json

# Scraped market data: caches of public APIs, not source. Each has a script that rebuilds
# it, named in research/README.md, so nothing here is lost by not committing it.
research/week_data.json
research/week_partial.json
research/bt30_*.json


# Parity harness: raw live recordings are large and machine-specific. A recording chosen as
# a test fixture is copied to tools/parity/fixtures/ (force-added past the kalshi_* rules).
tools/parity/recordings/
